# Postgres (usado pelo compose e pelo app)
POSTGRES_PASSWORD=troque-por-senha-forte
DATABASE_URL=postgresql://leadforge:troque-por-senha-forte@localhost:5434/leadforge

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-chave-forte
# REMOVIDO (SPEC-011/012): nao existe segredo global de webhook. Cada instancia tem um webhookToken proprio,
# embutido no CAMINHO da URL (/api/webhooks/whatsapp/{token}); o webhook e configurado por instancia (global desligado no compose).
# Defina APP_BASE_URL (URL publica do app, alcancavel pelo Evolution) para montar essa URL.

# n8n
N8N_ENCRYPTION_KEY=troque-por-chave-de-32-chars-ou-mais

# SMTP
# SPEC-038: alem de exemplo/preset para o cadastro de EmailAccount (SPEC-010), estas 4 envs sao usadas
# DIRETAMENTE por src/lib/channels/system-mail.ts para o e-mail TRANSACIONAL do sistema (ex.: link de
# redefinicao de senha) — sem SMTP_HOST, forgotPassword continua respondendo generico (nunca revela
# se o e-mail existe), mas nenhum e-mail e efetivamente enviado (falha logada so no servidor).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Resend (SPEC-046, OPCIONAL): e-mail transacional do sistema (esqueci-senha, lembretes de cobranca,
# boas-vindas de cortesia, assinatura efetuada, assinatura cancelada) tenta Resend PRIMEIRO quando
# RESEND_API_KEY esta setada; sem ela (ou em qualquer erro/timeout do Resend), cai automaticamente para
# o SMTP acima (fallback, D-046-2) - nada quebra so por faltar RESEND_API_KEY.
# RESEND_API_KEY=re_xxx
# D-046-1: remetente POR CENARIO (precisa ser dominio verificado no Resend). Ausente => cai em
# RESEND_FROM_EMAIL (generico) => SMTP_USER => "no-reply@leadforge.local".
# RESEND_FROM_NOREPLY=no-reply@seudominio.com   # esqueci-senha + convite de organizacao (SPEC-049, cenario org_invite)
# RESEND_FROM_SUPPORT=suporte@seudominio.com    # boas-vindas de conta de cortesia
# RESEND_FROM_BILLING=cobranca@seudominio.com   # lembretes de cobranca + assinatura efetuada/cancelada
# RESEND_FROM_EMAIL=no-reply@seudominio.com     # fallback generico se um dos 3 acima faltar

# Azure Communication Services Email (SPEC-048, OPCIONAL): so e-mail de sistema (nao o SMTP por usuario).
# Com EMAIL_PROVIDER=acs E a connection string setada, ACS e o primario; fallback Resend (se houver) -> SMTP.
# Sem EMAIL_PROVIDER (ou ACS nao configurado) o comportamento e o da SPEC-046 (Resend -> SMTP).
# EMAIL_PROVIDER=acs            # acs | resend | smtp
# AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://SEU-RECURSO.communication.azure.com/;accesskey=xxx   # SEGREDO, so server-side
# ACS_FROM_NOREPLY=DoNotReply@seudominio.com    # esqueci-senha + convite de organizacao (SPEC-049) (MailFrom do dominio verificado no ACS)
# ACS_FROM_SUPPORT=suporte@seudominio.com       # boas-vindas de cortesia
# ACS_FROM_BILLING=cobranca@seudominio.com      # cobranca + assinatura efetuada/cancelada

# SPEC-049 (multi-tenant N:N): nenhuma env nova. O link do convite usa APP_BASE_URL (/convite/<token>) e o e-mail sai pelo
# remetente NOREPLY acima. Rate limits de convite/codigo sao em memoria (por processo).

# Auth (SPEC-009). AUTH_SECRET obrigatorio, 32+ chars (ex.: openssl rand -base64 48)
AUTH_SECRET=troque-por-secret-de-32-chars-ou-mais
AUTH_URL=http://localhost:3000

# Admin do seed (npm run db:seed). Senha 12+ chars; se ausente, o seed pula o admin com aviso.
ADMIN_EMAIL=admin@leadforge.local
ADMIN_PASSWORD=

# Rate limit de login (SPEC-009): por padrao x-forwarded-for e IGNORADO (forjavel). Atras de proxy/CDN confiavel,
# defina o cabecalho de IP que ELE sobrescreve (ex.: x-real-ip, cf-connecting-ip). Vazio = IP "unknown" (limite so por e-mail).
# EM PRODUCAO e OBRIGATORIA para o rate limit por IP (login, signup, entrada em org): sem ela o limite por IP fica
# desativado (chave unica por requisicao, sem bucket global compartilhado) e valem so os limites por usuario/e-mail/token.
# TRUSTED_PROXY_IP_HEADER=x-real-ip
# Descadastro (SPEC-010): sem esta env o IP e "unknown" e o endpoint publico limita SO por token (10/min) + teto global (600/min),
# sem bloquear titulares legitimos atras do mesmo IP. Atras de proxy, defina-a para ativar tambem o limite por IP (30/min).

# Anti-SSRF do SMTP (SPEC-010): por padrao hosts que resolvem para rede interna (loopback, privados, link-local, metadados) sao bloqueados.
# true so para dev/SMTP interno confiavel (default false).
# ALLOW_PRIVATE_SMTP_HOSTS=false

# E-mail (SPEC-010). ENCRYPTION_KEY: 32 bytes base64 (openssl rand -base64 32). Cifra a senha SMTP (AES-256-GCM) e assina o
# link de descadastro (HMAC derivado). Obrigatoria so para usar e-mail; trocar a chave invalida senhas ja gravadas e links emitidos.
ENCRYPTION_KEY=
# SPEC-018: rotacao da ENCRYPTION_KEY (npm run secrets:reencrypt). Chaves so por env/stdin, nunca argumento. Uso pontual, nao deixe salvas.
# OLD_ENCRYPTION_KEY=
# NEW_ENCRYPTION_KEY=
# SPEC-018: EVOLUTION_API_URL/EVOLUTION_API_KEY acima viram FALLBACK: o painel (Configuracoes > Integracoes) tem precedencia.
# NAO existe env para liberar hosts privados de integracao: so pela confirmacao "instancia propria" no painel.
# URL publica base usada no link de descadastro (default: AUTH_URL).
# Tambem monta a URL do webhook WhatsApp ({APP_BASE_URL}/api/webhooks/whatsapp/{token}; a Evolution precisa alcanca-la). Default: AUTH_URL.
# APP_BASE_URL=https://app.exemplo.com

# Validador do 1o toque de WhatsApp (SPEC-017): palavras promocionais separadas por virgula (default: lista embutida).
# WHATSAPP_PROMO_WORDS=promocao,desconto,oferta,gratis

# Scheduler de follow-up (SPEC-013). CRON_SECRET: 32+ chars (openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'); sem ele /api/cron/tick responde 503.
# Agendar (a cada 1-2 min), sempre com o header Authorization:
#   crontab:  * * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" https://SEU-APP/api/cron/tick
#   n8n:      HTTP Request (POST, URL acima, Header Auth "Authorization: Bearer <CRON_SECRET>", Schedule Trigger 1 min)
#   Vercel:   vercel.json crons [{ "path": "/api/cron/tick", "schedule": "* * * * *" }] + env CRON_SECRET (a Vercel envia o Bearer; GET)
# Dev local sem HTTP: npm run tick
CRON_SECRET=
# Só dev: `npm run dev:tick` chama POST /api/cron/tick em loop (sem isso os criativos ficam em "Na fila" em local).
# DEV_TICK_INTERVAL_MS=15000
# DEV_TICK_URL=http://localhost:3000

# Ingestao de leads por HTTP (SPEC-014, OPCIONAL): POST /api/integrations/leads. DESLIGADO por padrao (503).
# Para ligar: INTEGRATION_LEADS_ENABLED=true (exatamente "true") E INGEST_SECRET com 32+ chars (mesmo comando do CRON_SECRET; use outro valor).
# INTEGRATION_LEADS_ENABLED=false
INGEST_SECRET=
# n8n (opcional): URL do LeadForge vista do container do n8n (default do compose: http://host.docker.internal:3000).
# LEADFORGE_URL=http://host.docker.internal:3000
# Orcamento por rodada (defaults): tempo em ms (default 25 s; teto = maxDuration 60 s - pior caso de envio 30 s - margem 5 s = 25 s) e teto de envios.
# SCHEDULER_TIME_BUDGET_MS=25000
# SCHEDULER_MAX_SENDS=20
# Dados de seed (leads source="seed") NUNCA sao enviados (filas do scheduler + canais). true SO para dev: libera envio real a leads de seed.
# Nunca defina em producao. Default: ausente/false.
# ALLOW_SEED_SENDS=false

# SPEC-015 busca de leads (Google Places, API oficial). Desligada por padrao; exige chave "places" cadastrada no painel.
# LEAD_SEARCH_ENABLED=false
# LEAD_SEARCH_MAX_RESULTS=20
# LEAD_SEARCH_DAILY_MAX_REQUESTS=3
# SPEC-058 "Buscar agora" (so owner): teto de buscas MANUAIS por campanha/dia (default 2, teto 20) e de chamadas pagas por organizacao/dia, manual+diaria somadas (default 10, teto 200). Separados do teto da diaria.
# LEAD_SEARCH_MANUAL_DAILY_MAX_REQUESTS=2
# LEAD_SEARCH_ORG_DAILY_MAX_REQUESTS=10
# Campanhas buscadas por tick (a busca roda no request do tick; sobras ficam p/ o proximo) e prazo p/ iniciar novas buscas (ms)
# LEAD_SEARCH_MAX_CAMPAIGNS_PER_TICK=3
# LEAD_SEARCH_TICK_DEADLINE_MS=30000

# Versao do WhatsApp Web usada no pareamento da Evolution (lida pelo docker-compose). Sem ela o QR nao e gerado (statusReason 405).
# CONFIG_SESSION_PHONE_VERSION=2.3000.1047967752
# Minutos continuos desconectada (sem logout confirmado) antes de pausar a instancia (default 10)
# WHATSAPP_DISCONNECT_GRACE_MINUTES=10

# Billing/assinatura (SPEC-033, D-33-5). Default "mock": checkout/trial funcionam ponta a ponta SEM conta/chaves
# externas (marca a Subscription direto, dispara os mesmos eventos do webhook internamente). Trocar para "stripe"
# exige STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET (conta Stripe ainda nao existe - D-33-5) e stripePriceId* cadastrados
# em cada Plan (hoje null, seed com precos PLACEHOLDER - D-33-2). POST /api/billing/webhook recebe os eventos do Stripe.
# PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# SPEC-047: 3a opcao de PAYMENT_PROVIDER, "abacatepay" (gateway brasileiro, foco em PIX). Stub PRONTO no
# codigo (src/lib/billing/providers/abacatepay.ts), mas SEM chamada de rede real ate as 2 envs abaixo
# estarem preenchidas (mesmo padrao do Stripe acima) - ausentes, o app roda em PAYMENT_PROVIDER=mock.
# D-047-1 (HIBRIDO): cartao usa recorrencia REAL do AbacatePay (subscriptions/create); PIX usa cobranca
# avulsa (transparents/create) com renovacao controlada pelo LeadForge (job no tick, Subscription.pixManaged).
# D-047-2: autenticacao do webhook e SEMPRE o ABACATEPAY_WEBHOOK_SECRET (32+ chars) - nunca logue a URL
# completa do webhook (ela carrega esse segredo na query string).
# PAYMENT_PROVIDER=abacatepay
# ABACATEPAY_API_KEY=
# ABACATEPAY_WEBHOOK_SECRET=
#
# QA fix (achado critico, rodada 2): em modo mock, verifyWebhookSignature sempre retorna true (sem gateway
# externo a validar) - por isso POST /api/billing/webhook exige TAMBEM "Authorization: Bearer
# MOCK_WEBHOOK_SECRET" (32+ chars, mesmo padrao do CRON_SECRET/INGEST_SECRET) quando PAYMENT_PROVIDER=mock.
# Ausente => a rota responde 503 (nunca fica aberta a chamador nao autenticado). So o caminho INTERNO
# (MockPaymentProvider.createCheckoutSession, sem HTTP) nao depende deste segredo.
# MOCK_WEBHOOK_SECRET=

# Storage de arquivos (SPEC-050, OPCIONAL). Sem env Azure o provider e `local` (filesystem em STORAGE_LOCAL_DIR, ignorado
# pelo git) em dev/teste; em producao sem Azure configurado a feature responde 503 "indisponivel" (o app nao quebra).
# STORAGE_PROVIDER=azure|local   # default: azure se AZURE_STORAGE_CONNECTION_STRING existir, senao local
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net   # SO server-side
# AZURE_STORAGE_CONTAINER=leadforge-files   # container unico e PRIVADO; chaves orgs/{orgId}/{category}/{uuid}-{nome} (D-050-1)
# STORAGE_LOCAL_DIR=.storage
# STORAGE_MAX_FILE_BYTES=52428800   # limite por arquivo (default 50 MB; D-050-4/5)
# STORAGE_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,video/mp4,video/webm,application/pdf,text/plain,text/markdown,text/csv

# Criativos: videos de avatar com IA (SPEC-051a, OPCIONAL). Provedor real NAO escolhido (Q-051-1): so `mock` (custo zero,
# catalogo fixo, video placeholder). Em producao exige CREATIVE_PROVIDER=mock explicito (senao a feature responde "indisponivel").
# A execucao dos jobs e por polling no /api/cron/tick (SPEC-013). Chave de provedor real futuro: global por env, SO server-side (D-051-2).
# CREATIVE_PROVIDER=mock
# CREATIVE_MAX_CONCURRENT_JOBS_PER_ORG=2   # geracoes simultaneas por org (default 2)
# CREATIVE_MAX_PER_MONTH_PER_ORG=20        # criativos enviados por org por mes UTC (default 20); cancelar antes do provedor devolve
# CREATIVE_MAX_DURATION_SEC=120            # duracao maxima do video (default 120s)
# CREATIVE_MAX_SCRIPT_CHARS=3000           # tamanho maximo do roteiro (default 3000)
# CREATIVE_SCRIPT_BLOCKLIST=               # termos proibidos separados por virgula (moderacao MINIMA; a real depende do provedor)
# CREATIVE_JOB_TIMEOUT_MS=1800000          # timeout total de um job (default 30 min)
# CREATIVE_JOB_MAX_ATTEMPTS=120            # chamadas ao provedor (create + polls) por job (default 120)
# CREATIVE_MOCK_DELAY_MS=3000              # so o mock: tempo ate o "video" ficar pronto

# --- Rate limit persistente (SPEC-059) ---
# Redis p/ compartilhar contadores de rate limit entre instancias/deploys. Ausente => memoria por processo.
# Se o Redis falhar, os limiters degradam para memoria (log "[rate-limit]"), nunca bloqueiam por erro do Redis.
# REDIS_URL=redis://localhost:6379
