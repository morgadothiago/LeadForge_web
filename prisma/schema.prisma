generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  active
  paused
  archived
}

enum Channel {
  email
  whatsapp
  linkedin
  phone
}

enum SequenceStatus {
  not_started
  active
  paused_replied
  /// SPEC-013: parada manual (stopSequence). Só volta por startSequence.
  paused_manual
  completed
  opted_out
}

enum TouchStatus {
  pending
  scheduled
  sending
  sent
  delivered
  failed
  skipped
  replied
}

enum TouchDirection {
  outbound
  inbound
}

enum Stage {
  novo_lead
  contactado
  em_followup
  interessado
  reuniao_agendada
  fechado
  perdido
}

enum WaStatus {
  disconnected
  connecting
  connected
}

enum WhatsAppProviderKind {
  evolution
  cloud_api
}

enum SuppressionKind {
  phone
  email
}

enum SuppressionReason {
  opt_out_reply
  opt_out_link
  opt_out_manual
  possible_opt_out_confirmed
  bounce
  manual
}

enum InstanceHealth {
  good
  warning
  paused
}

/// SPEC-030: status do tenant. `active` = opera normal. `suspended`/`cancelled` = cron nao dispara touches/busca de leads (gate minimo de billing; estados de assinatura mapeiam aqui, ver SPEC-033).
enum OrgStatus {
  active
  suspended
  cancelled
}

/// SPEC-030: papel do usuario DENTRO do tenant (nao confundir com User.role, que e papel de PLATAFORMA).
enum OrgRole {
  owner
  member
}

/// SPEC-030: tenant (assinante/"Provider"). Unidade de isolamento de dados e de cobranca (ver SPEC-033).
model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships          Membership[]
  campaigns            Campaign[]
  whatsappInstances    WhatsAppInstance[]
  emailAccounts        EmailAccount[]
  suppressions         Suppression[]
  schedulerRuns        SchedulerRun[]
  integrationSecrets   IntegrationSecret[]
  integrationAuditLogs IntegrationAuditLog[]
  agentSettings        AgentSettings?
  meetingSettings      MeetingSettings?
  agents               Agent[]
  knowledgeDocuments   KnowledgeDocument[]
  webhookEvents        WebhookEvent[]
  icpProfiles          IcpProfile[]
  sequences            Sequence[]
  messageTemplates     MessageTemplate[]
  mobileAlerts         MobileAlert[]

  @@index([status])
}

/// SPEC-030: liga User a Organization com papel dentro do tenant. N:N no schema (hoje so 1 membro/org na pratica; convite multi-membro e SPEC futura, D-30-4).
model Membership {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgRole   OrgRole      @default(owner)
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

/// SPEC-030: `role` e o papel de PLATAFORMA ("platform_admin" | "provider"), nao o papel dentro do tenant (esse e `Membership.orgRole`). `platform_admin` nao tem `Organization`/`Membership` propria; acessa dados via caminho cross-tenant explicito (`src/lib/tenant/admin-prisma.ts`).
model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  role          String         @default("provider")
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaigns     Campaign[]
  emailAccounts EmailAccount[]
  memberships   Membership[]
}

model IcpProfile {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  name        String
  niche       String
  location    String?
  companySize String?
  signals     String[]
  keywords    String[]
  sources     String[]
  desiredData String[]
  createdAt   DateTime     @default(now())
  campaigns   Campaign[]

  @@index([orgId])
}

model Campaign {
  id                 String            @id @default(uuid())
  orgId              String
  org                Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  name               String
  description        String?
  status             CampaignStatus    @default(active)
  icpId              String
  icp                IcpProfile        @relation(fields: [icpId], references: [id], onDelete: Restrict)
  sequenceId         String?
  sequence           Sequence?         @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  /// SPEC-013: true = fase 0 do tick inicia sozinha leads not_started elegíveis. Default false (início explícito).
  autoStart          Boolean           @default(false)
  whatsappInstanceId String?
  whatsappInstance   WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  leads              Lead[]
  opportunities      Opportunity[]
  meetings           Meeting[]
  templates          MessageTemplate[]
  searchRuns         SearchRun[]

  @@index([orgId, status])
  @@index([userId])
  @@index([status])
}

model Lead {
  id                String         @id @default(uuid())
  campaignId        String
  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  company           String?
  email             String?
  phone             String?
  website           String?
  linkedin          String?
  source            String?
  score             Float          @default(0)
  tags              String[]
  rawData           Json?
  sequenceStatus    SequenceStatus @default(not_started)
  currentStepOrder  Int            @default(0)
  nextTouchAt       DateTime?
  /// SPEC-013: instante do 1º toque da sequência (âncora de nextTouchAt = início + step.day). null = ainda não começou.
  sequenceStartedAt DateTime?
  repliedAt         DateTime?
  optedOutAt        DateTime?
  possibleOptOut    Boolean        @default(false)
  timezone          String         @default("America/Sao_Paulo")
  hasWhatsapp       Boolean?
  whatsappCheckedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  touches           Touch[]
  opportunities     Opportunity[]
  meetings          Meeting[]
  notes             LeadNote[]
  /// SPEC-019: estado de agentes de IA por lead. handoffAt != null = agente parou (handoff ou humano assumiu).
  agentTurns        Int            @default(0)
  handoffAt         DateTime?
  handoffReason     String?
  needsHuman        Boolean        @default(false)
  agentRuns         AgentRun[]
  drafts            Draft[]

  @@unique([campaignId, email])
  @@unique([campaignId, phone])
  @@index([campaignId, sequenceStatus, nextTouchAt])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Sequence {
  id        String         @id @default(uuid())
  orgId     String
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  name      String
  createdAt DateTime       @default(now())
  steps     SequenceStep[]
  campaigns Campaign[]

  @@index([orgId])
}

model SequenceStep {
  id                    String          @id @default(uuid())
  sequenceId            String
  sequence              Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  day                   Int
  channel               Channel
  templateId            String
  template              MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  order                 Int
  touches               Touch[]
  /// SPEC-019: passo gerado por agente (em vez do template fixo). Sem agente ativo: fallback para o template só se agentFallbackTemplate.
  agentId               String?
  agent                 Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentFallbackTemplate Boolean         @default(false)
  agentRuns             AgentRun[]

  @@unique([sequenceId, order])
  @@index([templateId])
}

model Touch {
  id                 String            @id @default(uuid())
  leadId             String
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepId             String?
  step               SequenceStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull)
  channel            Channel
  direction          TouchDirection    @default(outbound)
  status             TouchStatus       @default(pending)
  scheduledAt        DateTime?
  sentAt             DateTime?
  repliedAt          DateTime?
  externalId         String?
  error              String?
  /// SPEC-013: falhas já sofridas (retry automático limitado a 3, backoff 30 min/2 h/6 h).
  attempts           Int               @default(0)
  content            String?
  /// SPEC-019: true = `content` (e `subject`) vêm de um Draft de agente aprovado/autorizado; canais usam em vez do template.
  agentGenerated     Boolean           @default(false)
  subject            String?
  emailAccountId     String?
  emailAccount       EmailAccount?     @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  whatsappInstanceId String?
  whatsappInstance   WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  @@unique([leadId, stepId])
  @@index([leadId, createdAt])
  @@index([status, scheduledAt])
  @@index([emailAccountId, status, sentAt])
  @@index([whatsappInstanceId, status, sentAt])
}

model Opportunity {
  id           String         @id @default(uuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stage        Stage          @default(novo_lead)
  position     Int            @default(0)
  value        Float?
  notes        String?
  lostReason   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  meetings     Meeting[]
  stageHistory StageHistory[]

  @@unique([leadId, campaignId])
  @@index([campaignId, stage, position])
}

enum MeetingStatus {
  scheduled
  done
  cancelled
  no_show
}

enum MeetingSource {
  manual
  agent
  webhook
}

/// SPEC-028: reuniao agendada. UTC no banco; `timezone` IANA so para exibicao. `duration` (min) mantido em paralelo a `endsAt` (remocao em fase 2).
model Meeting {
  id              String        @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  duration        Int           @default(30)
  timezone        String        @default("America/Sao_Paulo")
  calendarEventId String?
  status          MeetingStatus @default(scheduled)
  link            String?
  source          MeetingSource @default(manual)
  notes           String?
  /// Idempotencia do webhook (unique; NULLs nao colidem no Postgres).
  externalId      String?       @unique
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  cancelledAt     DateTime?

  @@index([opportunityId])
  @@index([leadId])
  @@index([campaignId])
  @@index([startsAt])
  @@index([status, startsAt])
}

/// SPEC-028/030: lembretes de reuniao. Ate SPEC-030: singleton global (id="global"). Apos SPEC-030: 1 linha por Organization (deixa de ser singleton).
model MeetingSettings {
  id               String       @id @default(uuid())
  orgId            String       @unique
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  remindersEnabled Boolean      @default(true)
  /// Minutos antes do inicio; validos {1440,120,60,30,15,5}.
  offsetsMin       Int[]        @default([1440, 60, 15])
  updatedAt        DateTime     @updatedAt
}

model WhatsAppInstance {
  id              String               @id @default(uuid())
  orgId           String
  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  instanceName    String               @unique
  number          String
  provider        WhatsAppProviderKind @default(evolution)
  status          WaStatus             @default(disconnected)
  webhookToken    String               @unique
  apiKey          String?
  dailyLimit      Int                  @default(30)
  lastError       String?
  lastConnectedAt DateTime?
  /// Início da queda atual (desconexão sem logout confirmado); null = conectada. Pausa só após N min contínuos (SPEC-017).
  disconnectedAt  DateTime?
  warmupStartedAt DateTime?
  health          InstanceHealth       @default(good)
  pausedUntil     DateTime?
  pausedReason    String?
  /// Métricas de saúde ignoram envios anteriores a este instante (retomada = novo começo).
  healthResetAt   DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  campaigns       Campaign[]
  touches         Touch[]
  alerts          InstanceAlert[]

  @@index([orgId])
}

model InstanceAlert {
  id         String           @id @default(uuid())
  instanceId String
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  kind       String
  message    String
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  @@index([instanceId, createdAt])
}

model Suppression {
  id        String            @id @default(uuid())
  orgId     String
  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  kind      SuppressionKind
  value     String
  reason    SuppressionReason
  leadId    String?
  note      String?
  createdAt DateTime          @default(now())

  @@unique([orgId, kind, value])
  @@index([orgId, createdAt])
  @@index([createdAt])
}

model EmailAccount {
  id                String       @id @default(uuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  imapHost          String?
  smtpHost          String
  port              Int          @default(587)
  email             String       @unique
  encryptedPassword String
  isActive          Boolean      @default(true)
  fromName          String?
  dailyLimit        Int          @default(50)
  lastVerifiedAt    DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())
  touches           Touch[]

  @@index([orgId])
  @@index([userId])
}

model MessageTemplate {
  id         String         @id @default(uuid())
  orgId      String
  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel    Channel
  name       String
  subject    String?
  body       String
  createdAt  DateTime       @default(now())
  steps      SequenceStep[]

  @@index([orgId])
  @@index([campaignId])
}

/// SPEC-030: `orgId` resolvido a partir do token/instancia recebida no webhook (nullable: nem todo evento resolve a org, ex. token invalido/nao encontrado — ver Riscos da SPEC-030).
model WebhookEvent {
  id          String        @id @default(uuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  source      String
  eventId     String?       @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([source, createdAt])
  @@index([orgId, createdAt])
}

model StageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     Stage?
  toStage       Stage
  changedAt     DateTime    @default(now())

  @@index([opportunityId, changedAt])
  @@index([toStage, changedAt])
}

/// SPEC-013: uma linha por rodada do scheduler (/api/cron/tick ou npm run tick). Sem PII/segredo.
/// SPEC-030: `orgId` null = rodada "meta" do tick (ex.: status "locked", outra rodada já em andamento) que não pertence a nenhuma org especifica. Rodadas normais tem 1 linha por Organization ativa processada no tick.
model SchedulerRun {
  id         String        @id @default(uuid())
  orgId      String?
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  finishedAt DateTime?
  status     String       @default("running")
  counters   Json         @default("{}")
  error      String?

  @@index([orgId, startedAt])
  @@index([startedAt])
}

/// SPEC-018: segredos de integração cadastrados no painel. `encryptedValue` = secret-box (v1:iv:tag:cipher). NUNCA devolver/logar o valor.
enum IntegrationKind {
  evolution
  n8n
  llm
  places
}

enum IntegrationAuditAction {
  create
  rotate
  delete
  test
  update_url
}

model IntegrationSecret {
  id               String          @id @default(uuid())
  orgId            String
  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration      IntegrationKind
  name             String          @default("default")
  encryptedValue   String
  /// Últimos 4 caracteres do valor (exibição).
  hint             String
  baseUrl          String?
  /// "Instância própria": aceita localhost/rede privada (metadados/link-local sempre bloqueados).
  allowPrivateHost Boolean         @default(false)
  updatedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  lastTestError    String?

  @@unique([orgId, integration, name])
}

model IntegrationAuditLog {
  id               String                 @id @default(uuid())
  orgId            String
  org              Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId           String
  integration      IntegrationKind
  action           IntegrationAuditAction
  /// Host mascarado (ex.: "ev***.example.com"); nunca o valor do segredo.
  hostMasked       String?
  /// Confirmação "instância própria" vigente no momento da ação (create/update_url).
  allowPrivateHost Boolean?
  at               DateTime               @default(now())

  @@index([orgId, integration, at])
  @@index([integration, at])
}

// ---------- SPEC-019: Agentes de IA ----------
enum AgentRole {
  sdr
  followup
  closer
}

enum AgentAutonomy {
  draft
  sampled
  auto
}

enum AgentRunStatus {
  queued
  running
  completed
  skipped
  blocked
  handoff
  failed
}

enum DraftStatus {
  pending
  approved
  edited
  rejected
  sent
  expired
  blocked
}

/// SPEC-019/030: kill switch (default LIGADO = agentes desligados) e teto mensal. Ate SPEC-030: singleton global (id="global"). Apos SPEC-030: 1 linha por Organization.
model AgentSettings {
  id                 String       @id @default(uuid())
  orgId              String       @unique
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  killSwitch         Boolean      @default(true)
  monthlyBudgetCents Int?
  updatedAt          DateTime     @updatedAt
  updatedBy          String?
}

model Agent {
  id                 String              @id @default(uuid())
  orgId              String
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  role               AgentRole
  name               String
  active             Boolean             @default(false)
  persona            String              @default("")
  objective          String              @default("")
  tone               String              @default("")
  promptVersion      Int                 @default(1)
  model              String              @default("claude-haiku-4-5")
  autonomy           AgentAutonomy       @default(draft)
  samplePercent      Int                 @default(20)
  /// null = sem teto = agente NÃO executa (padrão desligado até haver teto).
  monthlyBudgetCents Int?
  dailyMessageLimit  Int                 @default(20)
  maxTurnsPerLead    Int                 @default(5)
  allowedTools       String[]
  escalationRules    Json?
  minConfidence      Float               @default(0.6)
  disclosureEnabled  Boolean             @default(false)
  disclosureText     String?
  /// Closer: link https da call, incluído na resposta e no aviso de handoff ao humano.
  callLink           String?
  /// Confirmação explícita (Closer em auto): data da confirmação + aviso de risco de banimento/LGPD.
  autoConfirmedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  updatedBy          String?
  knowledge          KnowledgeDocument[]
  runs               AgentRun[]
  steps              SequenceStep[]

  @@index([orgId])
}

/// SPEC-030: `orgId` direto (alem de `agentId`) para query eficiente e para o caso `agentId` null.
model KnowledgeDocument {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  agentId   String?
  agent     Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String
  content   String
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
  @@index([agentId])
}

model AgentRun {
  id                 String         @id @default(uuid())
  agentId            String
  agent              Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadId             String
  lead               Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepId             String?
  step               SequenceStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)
  touchId            String?
  trigger            String
  status             AgentRunStatus @default(queued)
  model              String?
  tokensIn           Int            @default(0)
  tokensOut          Int            @default(0)
  /// Custo em micro-dólares (1 USD = 1_000_000); orçamento em centavos = 10_000 micro por centavo.
  costMicros         Int            @default(0)
  latencyMs          Int?
  /// Saída estruturada validada (retenção limitada: limpo por purgeAgentData).
  result             Json?
  guardrailsViolated String[]
  error              String?
  createdAt          DateTime       @default(now())
  processedAt        DateTime?
  draft              Draft?

  @@unique([leadId, stepId, trigger])
  @@index([status, createdAt])
  @@index([agentId, createdAt])
}

model Draft {
  id           String      @id @default(uuid())
  agentRunId   String      @unique
  agentRun     AgentRun    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      Channel
  subject      String?
  body         String
  status       DraftStatus @default(pending)
  editedBody   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?
  touchId      String?
  createdAt    DateTime    @default(now())

  @@index([status, createdAt])
  @@index([leadId])
}

/// SPEC-015: log de execução da busca de leads por IA/fonte oficial. Sem PII: só contadores.
model SearchRun {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source     String
  trigger    String    @default("manual")
  status     String    @default("running")
  requests   Int       @default(0)
  found      Int       @default(0)
  created    Int       @default(0)
  duplicate  Int       @default(0)
  suppressed Int       @default(0)
  invalid    Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([campaignId, startedAt])
}

/// SPEC-021: dispositivo do app mobile. Refresh token NUNCA gravado em claro (só sha256). prevRefreshHash detecta reuso.
model MobileDevice {
  id               String    @id @default(uuid())
  userId           String
  name             String
  platform         String
  refreshHash      String    @unique
  prevRefreshHash  String?
  refreshExpiresAt DateTime
  pushToken        String?
  /// SPEC-023: preferencias de push por kind ({kind: boolean}); ausente = padrao (tudo ligado, exceto lead_replied).
  pushPrefs        Json?
  appVersion       String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?

  @@index([userId, createdAt])
  @@index([prevRefreshHash])
}

/// SPEC-023: alerta de monitoramento deduplicado (dedupeKey unico por episodio). Sem PII em title/body.
/// SPEC-030: `orgId` obrigatorio (vazamento cross-tenant corrigido — a varredura de `src/lib/mobile/alerts.ts`
/// agora roda por Organization ATIVA e cada candidato resolve a org dona do evento antes de criar o alerta).
model MobileAlert {
  id         String       @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind       String
  severity   String
  dedupeKey  String       @unique
  title      String
  body       String
  refType    String
  refId      String?
  /// Link https da call (handoff do Closer); so trafega na API autenticada, nunca no push.
  link       String?
  createdAt  DateTime     @default(now())
  readAt     DateTime?
  resolvedAt DateTime?

  @@index([orgId, createdAt, id])
  @@index([orgId, kind, resolvedAt])
  @@index([createdAt, id])
  @@index([kind, resolvedAt])
}

/// SPEC-026: auditoria das acoes de gestao do app (sem PII: so ids) + idempotencia por (deviceId, Idempotency-Key).
model MobileActionLog {
  id             String   @id @default(uuid())
  userId         String
  deviceId       String
  action         String
  target         String?
  outcome        String
  idempotencyKey String?
  respStatus     Int?
  respBody       Json?
  createdAt      DateTime @default(now())

  @@unique([deviceId, idempotencyKey])
  @@index([userId, createdAt])
}
