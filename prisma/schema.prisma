generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  active
  paused
  archived
}

enum Channel {
  email
  whatsapp
  linkedin
  phone
}

enum SequenceStatus {
  not_started
  active
  paused_replied
  /// SPEC-013: parada manual (stopSequence). Só volta por startSequence.
  paused_manual
  completed
  opted_out
}

enum TouchStatus {
  pending
  scheduled
  sending
  sent
  delivered
  failed
  skipped
  replied
}

enum TouchDirection {
  outbound
  inbound
}

enum Stage {
  novo_lead
  contactado
  em_followup
  interessado
  reuniao_agendada
  fechado
  perdido
}

enum WaStatus {
  disconnected
  connecting
  connected
}

enum WhatsAppProviderKind {
  evolution
  cloud_api
}

enum SuppressionKind {
  phone
  email
}

enum SuppressionReason {
  opt_out_reply
  opt_out_link
  opt_out_manual
  possible_opt_out_confirmed
  bounce
  manual
}

enum InstanceHealth {
  good
  warning
  paused
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  role          String         @default("admin")
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaigns     Campaign[]
  emailAccounts EmailAccount[]
}

model IcpProfile {
  id          String     @id @default(uuid())
  name        String
  niche       String
  location    String?
  companySize String?
  signals     String[]
  keywords    String[]
  sources     String[]
  desiredData String[]
  createdAt   DateTime   @default(now())
  campaigns   Campaign[]
}

model Campaign {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  status             CampaignStatus    @default(active)
  icpId              String
  icp                IcpProfile        @relation(fields: [icpId], references: [id], onDelete: Restrict)
  sequenceId         String?
  sequence           Sequence?         @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  /// SPEC-013: true = fase 0 do tick inicia sozinha leads not_started elegíveis. Default false (início explícito).
  autoStart          Boolean           @default(false)
  whatsappInstanceId String?
  whatsappInstance   WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  leads              Lead[]
  opportunities      Opportunity[]
  templates          MessageTemplate[]

  @@index([userId])
  @@index([status])
}

model Lead {
  id                String         @id @default(uuid())
  campaignId        String
  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  company           String?
  email             String?
  phone             String?
  website           String?
  linkedin          String?
  source            String?
  score             Float          @default(0)
  tags              String[]
  rawData           Json?
  sequenceStatus    SequenceStatus @default(not_started)
  currentStepOrder  Int            @default(0)
  nextTouchAt       DateTime?
  /// SPEC-013: instante do 1º toque da sequência (âncora de nextTouchAt = início + step.day). null = ainda não começou.
  sequenceStartedAt DateTime?
  repliedAt         DateTime?
  optedOutAt        DateTime?
  possibleOptOut    Boolean        @default(false)
  timezone          String         @default("America/Sao_Paulo")
  hasWhatsapp       Boolean?
  whatsappCheckedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  touches           Touch[]
  opportunities     Opportunity[]
  meetings          Meeting[]
  notes             LeadNote[]

  @@unique([campaignId, email])
  @@unique([campaignId, phone])
  @@index([campaignId, sequenceStatus, nextTouchAt])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Sequence {
  id        String         @id @default(uuid())
  name      String
  createdAt DateTime       @default(now())
  steps     SequenceStep[]
  campaigns Campaign[]
}

model SequenceStep {
  id         String          @id @default(uuid())
  sequenceId String
  sequence   Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  day        Int
  channel    Channel
  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  order      Int
  touches    Touch[]

  @@unique([sequenceId, order])
  @@index([templateId])
}

model Touch {
  id                 String            @id @default(uuid())
  leadId             String
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepId             String?
  step               SequenceStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull)
  channel            Channel
  direction          TouchDirection    @default(outbound)
  status             TouchStatus       @default(pending)
  scheduledAt        DateTime?
  sentAt             DateTime?
  repliedAt          DateTime?
  externalId         String?
  error              String?
  /// SPEC-013: falhas já sofridas (retry automático limitado a 3, backoff 30 min/2 h/6 h).
  attempts           Int               @default(0)
  content            String?
  emailAccountId     String?
  emailAccount       EmailAccount?     @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  whatsappInstanceId String?
  whatsappInstance   WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  @@unique([leadId, stepId])
  @@index([leadId, createdAt])
  @@index([status, scheduledAt])
  @@index([emailAccountId, status, sentAt])
  @@index([whatsappInstanceId, status, sentAt])
}

model Opportunity {
  id           String         @id @default(uuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stage        Stage          @default(novo_lead)
  position     Int            @default(0)
  value        Float?
  notes        String?
  lostReason   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  meetings     Meeting[]
  stageHistory StageHistory[]

  @@unique([leadId, campaignId])
  @@index([campaignId, stage, position])
}

model Meeting {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  duration        Int         @default(30)
  calendarEventId String?
  status          String      @default("scheduled")
  createdAt       DateTime    @default(now())

  @@index([opportunityId])
  @@index([leadId])
}

model WhatsAppInstance {
  id              String               @id @default(uuid())
  instanceName    String               @unique
  number          String
  provider        WhatsAppProviderKind @default(evolution)
  status          WaStatus             @default(disconnected)
  webhookToken    String               @unique
  apiKey          String?
  dailyLimit      Int                  @default(30)
  lastError       String?
  lastConnectedAt DateTime?
  /// Início da queda atual (desconexão sem logout confirmado); null = conectada. Pausa só após N min contínuos (SPEC-017).
  disconnectedAt  DateTime?
  warmupStartedAt DateTime?
  health          InstanceHealth       @default(good)
  pausedUntil     DateTime?
  pausedReason    String?
  /// Métricas de saúde ignoram envios anteriores a este instante (retomada = novo começo).
  healthResetAt   DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  campaigns       Campaign[]
  touches         Touch[]
  alerts          InstanceAlert[]
}

model InstanceAlert {
  id         String           @id @default(uuid())
  instanceId String
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  kind       String
  message    String
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  @@index([instanceId, createdAt])
}

model Suppression {
  id        String            @id @default(uuid())
  kind      SuppressionKind
  value     String
  reason    SuppressionReason
  leadId    String?
  note      String?
  createdAt DateTime          @default(now())

  @@unique([kind, value])
  @@index([createdAt])
}

model EmailAccount {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  imapHost          String?
  smtpHost          String
  port              Int       @default(587)
  email             String    @unique
  encryptedPassword String
  isActive          Boolean   @default(true)
  fromName          String?
  dailyLimit        Int       @default(50)
  lastVerifiedAt    DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  touches           Touch[]

  @@index([userId])
}

model MessageTemplate {
  id         String         @id @default(uuid())
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel    Channel
  name       String
  subject    String?
  body       String
  createdAt  DateTime       @default(now())
  steps      SequenceStep[]

  @@index([campaignId])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  source      String
  eventId     String?   @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, createdAt])
}

model StageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     Stage?
  toStage       Stage
  changedAt     DateTime    @default(now())

  @@index([opportunityId, changedAt])
  @@index([toStage, changedAt])
}

/// SPEC-013: uma linha por rodada do scheduler (/api/cron/tick ou npm run tick). Sem PII/segredo.
model SchedulerRun {
  id         String    @id @default(uuid())
  startedAt  DateTime
  finishedAt DateTime?
  status     String    @default("running")
  counters   Json      @default("{}")
  error      String?

  @@index([startedAt])
}

/// SPEC-018: segredos de integração cadastrados no painel. `encryptedValue` = secret-box (v1:iv:tag:cipher). NUNCA devolver/logar o valor.
enum IntegrationKind {
  evolution
  n8n
  llm
  places
}

enum IntegrationAuditAction {
  create
  rotate
  delete
  test
  update_url
}

model IntegrationSecret {
  id               String          @id @default(uuid())
  integration      IntegrationKind
  name             String          @default("default")
  encryptedValue   String
  /// Últimos 4 caracteres do valor (exibição).
  hint             String
  baseUrl          String?
  /// "Instância própria": aceita localhost/rede privada (metadados/link-local sempre bloqueados).
  allowPrivateHost Boolean         @default(false)
  updatedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  lastTestError    String?

  @@unique([integration, name])
}

model IntegrationAuditLog {
  id               String                 @id @default(uuid())
  userId           String
  integration      IntegrationKind
  action           IntegrationAuditAction
  /// Host mascarado (ex.: "ev***.example.com"); nunca o valor do segredo.
  hostMasked       String?
  /// Confirmação "instância própria" vigente no momento da ação (create/update_url).
  allowPrivateHost Boolean?
  at               DateTime               @default(now())

  @@index([integration, at])
}
