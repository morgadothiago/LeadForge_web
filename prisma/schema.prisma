generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  active
  paused
  archived
}

enum Channel {
  email
  whatsapp
  linkedin
  phone
}

enum SequenceStatus {
  not_started
  active
  paused_replied
  /// SPEC-013: parada manual (stopSequence). Só volta por startSequence.
  paused_manual
  completed
  opted_out
}

enum TouchStatus {
  pending
  scheduled
  sending
  sent
  delivered
  failed
  skipped
  replied
}

enum TouchDirection {
  outbound
  inbound
}

enum Stage {
  novo_lead
  contactado
  em_followup
  interessado
  reuniao_agendada
  fechado
  perdido
}

enum WaStatus {
  disconnected
  connecting
  connected
}

enum WhatsAppProviderKind {
  evolution
  cloud_api
}

enum SuppressionKind {
  phone
  email
}

enum SuppressionReason {
  opt_out_reply
  opt_out_link
  opt_out_manual
  possible_opt_out_confirmed
  bounce
  manual
}

enum InstanceHealth {
  good
  warning
  paused
}

/// SPEC-030: status do tenant. `active` = opera normal. `suspended`/`cancelled` = cron nao dispara touches/busca de leads (gate minimo de billing; estados de assinatura mapeiam aqui, ver SPEC-033).
enum OrgStatus {
  active
  suspended
  cancelled
}

/// SPEC-039 (correcao QA, D-039-1): distingue POR QUE `Organization.status` chegou a `suspended` — o
/// unico jeito de saber isso sem ambiguidade e um sinal explicito gravado no momento da transicao
/// (nunca re-derivado do estado atual depois). `automatic` = `syncOrgStatuses` (status-map.ts) suspendeu
/// por causa da propria `Subscription` (grace de past_due expirado, ou canceled/incomplete). `manual` =
/// `suspendOrganization` (SPEC-031, platform_admin) suspendeu por acao humana, independente do estado da
/// assinatura. `reminders.ts` usa este campo para o gatilho `auto_suspended` NUNCA disparar para
/// suspensao manual (mesmo quando a subscription tambem esta em `past_due` por coincidencia).
enum OrgSuspendedReason {
  automatic
  manual
}

/// SPEC-033: espelha o vocabulario do provedor de pagamento (Stripe, D-33-1). `incomplete` = checkout iniciado mas nao confirmado.
enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

/// SPEC-033: periodicidade de cobranca (D-33-2: mensal ou anual, anual com desconto).
enum BillingCadence {
  monthly
  yearly
}

/// SPEC-030: papel do usuario DENTRO do tenant (nao confundir com User.role, que e papel de PLATAFORMA).
enum OrgRole {
  owner
  member
}

/// SPEC-030: tenant (assinante/"Provider"). Unidade de isolamento de dados e de cobranca (ver SPEC-033).
model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(active)
  /// SPEC-039 (correcao QA): por que `status` esta em `suspended` (null quando `status != suspended`, ou
  /// para orgs nunca suspensas). Gravado SEMPRE no momento exato da transicao — `syncOrgStatuses` grava
  /// `automatic`, `suspendOrganization` grava `manual` — nunca re-derivado depois.
  suspendedReason OrgSuspendedReason?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// SPEC-033 (D-33-4): marcado quando o job de expurgo anonimiza o dado da org (90 dias apos cancelamento). null = nunca expurgada.
  purgedAt  DateTime?

  subscription         Subscription?
  memberships          Membership[]
  campaigns            Campaign[]
  whatsappInstances    WhatsAppInstance[]
  emailAccounts        EmailAccount[]
  suppressions         Suppression[]
  schedulerRuns        SchedulerRun[]
  integrationSecrets   IntegrationSecret[]
  integrationAuditLogs IntegrationAuditLog[]
  platformAuditLogs    PlatformAuditLog[]
  agentSettings        AgentSettings?
  meetingSettings      MeetingSettings?
  agents               Agent[]
  knowledgeDocuments   KnowledgeDocument[]
  webhookEvents        WebhookEvent[]
  billingReminderLogs  BillingReminderLog[]
  icpProfiles          IcpProfile[]
  sequences            Sequence[]
  messageTemplates     MessageTemplate[]
  mobileAlerts         MobileAlert[]
  leadSourceBindings   LeadSourceBinding[]

  @@index([status])
}

/// SPEC-030: liga User a Organization com papel dentro do tenant. N:N no schema (hoje so 1 membro/org na pratica; convite multi-membro e SPEC futura, D-30-4).
model Membership {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgRole   OrgRole      @default(owner)
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

/// SPEC-030: `role` e o papel de PLATAFORMA ("platform_admin" | "provider"), nao o papel dentro do tenant (esse e `Membership.orgRole`). `platform_admin` nao tem `Organization`/`Membership` propria; acessa dados via caminho cross-tenant explicito (`src/lib/tenant/admin-prisma.ts`).
model User {
  id                    String               @id @default(uuid())
  name                  String
  email                 String               @unique
  role                  String               @default("provider")
  passwordHash          String?
  avatarUrl             String?
  /// SPEC-038 (D-038-2): redefinir a senha grava `now()` aqui. `requireUser()` rejeita qualquer sessão (JWT)
  /// emitida ANTES deste timestamp (compara com o `iat` do token) — mecanismo de invalidação em massa das
  /// sessões antigas, já que a sessão web é JWT stateless (sem tabela de sessões para revogar diretamente).
  sessionsInvalidatedAt DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  campaigns             Campaign[]
  emailAccounts         EmailAccount[]
  memberships           Membership[]
  passwordResetTokens   PasswordResetToken[]
}

/// SPEC-038: token de "esqueci minha senha". Só o hash (sha256) é gravado — nunca o valor em claro (mesmo
/// cuidado de `MobileDevice.refreshHash`/`IntegrationSecret`). `expiresAt` = criação + 24h (D-038-1, decisão
/// explícita do usuário — não o padrão de mercado de 30-60min). `usedAt` marca consumo (nunca reutilizável).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model IcpProfile {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  name        String
  niche       String
  location    String?
  companySize String?
  signals     String[]
  keywords    String[]
  sources     String[]
  desiredData String[]
  createdAt   DateTime     @default(now())
  campaigns   Campaign[]

  @@index([orgId])
}

model Campaign {
  id                 String            @id @default(uuid())
  orgId              String
  org                Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  name               String
  description        String?
  status             CampaignStatus    @default(active)
  icpId              String
  icp                IcpProfile        @relation(fields: [icpId], references: [id], onDelete: Restrict)
  sequenceId         String?
  sequence           Sequence?         @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  /// SPEC-013: true = fase 0 do tick inicia sozinha leads not_started elegíveis. Default false (início explícito).
  autoStart          Boolean           @default(false)
  whatsappInstanceId String?
  whatsappInstance   WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  leads              Lead[]
  opportunities      Opportunity[]
  meetings           Meeting[]
  templates          MessageTemplate[]
  searchRuns         SearchRun[]
  leadSourceBindings LeadSourceBinding[]

  @@index([orgId, status])
  @@index([userId])
  @@index([status])
}

model Lead {
  id                String         @id @default(uuid())
  campaignId        String
  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  company           String?
  email             String?
  phone             String?
  website           String?
  linkedin          String?
  source            String?
  score             Float          @default(0)
  tags              String[]
  rawData           Json?
  sequenceStatus    SequenceStatus @default(not_started)
  currentStepOrder  Int            @default(0)
  nextTouchAt       DateTime?
  /// SPEC-013: instante do 1º toque da sequência (âncora de nextTouchAt = início + step.day). null = ainda não começou.
  sequenceStartedAt DateTime?
  repliedAt         DateTime?
  optedOutAt        DateTime?
  possibleOptOut    Boolean        @default(false)
  timezone          String         @default("America/Sao_Paulo")
  hasWhatsapp       Boolean?
  whatsappCheckedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  touches           Touch[]
  opportunities     Opportunity[]
  meetings          Meeting[]
  notes             LeadNote[]
  /// SPEC-019: estado de agentes de IA por lead. handoffAt != null = agente parou (handoff ou humano assumiu).
  agentTurns        Int            @default(0)
  handoffAt         DateTime?
  handoffReason     String?
  needsHuman        Boolean        @default(false)
  agentRuns         AgentRun[]
  drafts            Draft[]

  @@unique([campaignId, email])
  @@unique([campaignId, phone])
  @@index([campaignId, sequenceStatus, nextTouchAt])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Sequence {
  id        String         @id @default(uuid())
  orgId     String
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  name      String
  createdAt DateTime       @default(now())
  steps     SequenceStep[]
  campaigns Campaign[]

  @@index([orgId])
}

model SequenceStep {
  id                    String          @id @default(uuid())
  sequenceId            String
  sequence              Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  day                   Int
  channel               Channel
  templateId            String
  template              MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  order                 Int
  touches               Touch[]
  /// SPEC-019: passo gerado por agente (em vez do template fixo). Sem agente ativo: fallback para o template só se agentFallbackTemplate.
  agentId               String?
  agent                 Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentFallbackTemplate Boolean         @default(false)
  agentRuns             AgentRun[]

  @@unique([sequenceId, order])
  @@index([templateId])
}

model Touch {
  id                 String            @id @default(uuid())
  leadId             String
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepId             String?
  step               SequenceStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull)
  channel            Channel
  direction          TouchDirection    @default(outbound)
  status             TouchStatus       @default(pending)
  scheduledAt        DateTime?
  sentAt             DateTime?
  repliedAt          DateTime?
  externalId         String?
  error              String?
  /// SPEC-013: falhas já sofridas (retry automático limitado a 3, backoff 30 min/2 h/6 h).
  attempts           Int               @default(0)
  content            String?
  /// SPEC-019: true = `content` (e `subject`) vêm de um Draft de agente aprovado/autorizado; canais usam em vez do template.
  agentGenerated     Boolean           @default(false)
  subject            String?
  emailAccountId     String?
  emailAccount       EmailAccount?     @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  whatsappInstanceId String?
  whatsappInstance   WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  @@unique([leadId, stepId])
  @@index([leadId, createdAt])
  @@index([status, scheduledAt])
  @@index([emailAccountId, status, sentAt])
  @@index([whatsappInstanceId, status, sentAt])
}

model Opportunity {
  id           String         @id @default(uuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stage        Stage          @default(novo_lead)
  position     Int            @default(0)
  value        Float?
  notes        String?
  lostReason   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  meetings     Meeting[]
  stageHistory StageHistory[]

  @@unique([leadId, campaignId])
  @@index([campaignId, stage, position])
}

enum MeetingStatus {
  scheduled
  done
  cancelled
  no_show
}

enum MeetingSource {
  manual
  agent
  webhook
}

/// SPEC-028: reuniao agendada. UTC no banco; `timezone` IANA so para exibicao. `duration` (min) mantido em paralelo a `endsAt` (remocao em fase 2).
model Meeting {
  id              String        @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  duration        Int           @default(30)
  timezone        String        @default("America/Sao_Paulo")
  calendarEventId String?
  status          MeetingStatus @default(scheduled)
  link            String?
  source          MeetingSource @default(manual)
  notes           String?
  /// Idempotencia do webhook (unique; NULLs nao colidem no Postgres).
  externalId      String?       @unique
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  cancelledAt     DateTime?

  @@index([opportunityId])
  @@index([leadId])
  @@index([campaignId])
  @@index([startsAt])
  @@index([status, startsAt])
}

/// SPEC-028/030: lembretes de reuniao. Ate SPEC-030: singleton global (id="global"). Apos SPEC-030: 1 linha por Organization (deixa de ser singleton).
model MeetingSettings {
  id               String       @id @default(uuid())
  orgId            String       @unique
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  remindersEnabled Boolean      @default(true)
  /// Minutos antes do inicio; validos {1440,120,60,30,15,5}.
  offsetsMin       Int[]        @default([1440, 60, 15])
  updatedAt        DateTime     @updatedAt
}

model WhatsAppInstance {
  id              String               @id @default(uuid())
  orgId           String
  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  instanceName    String               @unique
  number          String
  provider        WhatsAppProviderKind @default(evolution)
  status          WaStatus             @default(disconnected)
  webhookToken    String               @unique
  apiKey          String?
  dailyLimit      Int                  @default(30)
  lastError       String?
  lastConnectedAt DateTime?
  /// Início da queda atual (desconexão sem logout confirmado); null = conectada. Pausa só após N min contínuos (SPEC-017).
  disconnectedAt  DateTime?
  warmupStartedAt DateTime?
  health          InstanceHealth       @default(good)
  pausedUntil     DateTime?
  pausedReason    String?
  /// Métricas de saúde ignoram envios anteriores a este instante (retomada = novo começo).
  healthResetAt   DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  campaigns       Campaign[]
  touches         Touch[]
  alerts          InstanceAlert[]

  @@index([orgId])
}

model InstanceAlert {
  id         String           @id @default(uuid())
  instanceId String
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  kind       String
  message    String
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  @@index([instanceId, createdAt])
}

model Suppression {
  id        String            @id @default(uuid())
  orgId     String
  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  kind      SuppressionKind
  value     String
  reason    SuppressionReason
  leadId    String?
  note      String?
  createdAt DateTime          @default(now())

  @@unique([orgId, kind, value])
  @@index([orgId, createdAt])
  @@index([createdAt])
}

model EmailAccount {
  id                String       @id @default(uuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  imapHost          String?
  smtpHost          String
  port              Int          @default(587)
  email             String       @unique
  encryptedPassword String
  isActive          Boolean      @default(true)
  fromName          String?
  dailyLimit        Int          @default(50)
  lastVerifiedAt    DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())
  touches           Touch[]

  @@index([orgId])
  @@index([userId])
}

model MessageTemplate {
  id         String         @id @default(uuid())
  orgId      String
  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel    Channel
  name       String
  subject    String?
  body       String
  createdAt  DateTime       @default(now())
  steps      SequenceStep[]

  @@index([orgId])
  @@index([campaignId])
}

/// SPEC-030: `orgId` resolvido a partir do token/instancia recebida no webhook (nullable: nem todo evento resolve a org, ex. token invalido/nao encontrado — ver Riscos da SPEC-030).
model WebhookEvent {
  id          String        @id @default(uuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  source      String
  eventId     String?       @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([source, createdAt])
  @@index([orgId, createdAt])
}

/// SPEC-041 (D-041-3): vínculo 1:1 EXPLÍCITO entre uma Conta de Anúncios do Google Ads / Página do Meta e uma Campaign.
/// Cadastrado pelo Provider (usuário orgRole owner/admin da org, papel "provider" em `User.role`). É a ÚNICA forma de
/// resolver org/campanha a partir do payload de um webhook de lead do Google/Meta — nunca um segredo global compartilhado
/// (o padrão de risco documentado no INGEST_SECRET global de `/api/integrations/leads`, SPEC-014).
/// `externalAccountId`: Google -> o `google_key` configurado pelo Provider na extensão de formulário (identifica E autentica,
/// mesmo padrão de `WhatsAppInstance.webhookToken`); Meta -> o `page_id` (Facebook Page ID) que chega no webhook `leadgen`
/// (identifica; a autenticidade do webhook em si vem da assinatura `X-Hub-Signature-256`, verificada ANTES de qualquer uso deste vínculo).
model LeadSourceBinding {
  id                String             @id @default(uuid())
  orgId             String
  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  provider          LeadSourceProvider
  externalAccountId String
  /// Rótulo livre pro Provider reconhecer a conta/página (ex.: nome da conta de anúncios/página) — nunca usado na resolução.
  label             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([provider, externalAccountId])
  @@index([orgId])
  @@index([campaignId])
}

model StageHistory {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     Stage?
  toStage       Stage
  changedAt     DateTime    @default(now())

  @@index([opportunityId, changedAt])
  @@index([toStage, changedAt])
}

/// SPEC-013: uma linha por rodada do scheduler (/api/cron/tick ou npm run tick). Sem PII/segredo.
/// SPEC-030: `orgId` null = rodada "meta" do tick (ex.: status "locked", outra rodada já em andamento) que não pertence a nenhuma org especifica. Rodadas normais tem 1 linha por Organization ativa processada no tick.
model SchedulerRun {
  id         String        @id @default(uuid())
  orgId      String?
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  finishedAt DateTime?
  status     String        @default("running")
  counters   Json          @default("{}")
  error      String?

  @@index([orgId, startedAt])
  @@index([startedAt])
}

/// SPEC-018: segredos de integração cadastrados no painel. `encryptedValue` = secret-box (v1:iv:tag:cipher). NUNCA devolver/logar o valor.
enum IntegrationKind {
  evolution
  n8n
  llm
  places
  /// SPEC-041: segredo de validação do webhook do Google Ads Lead Form (não usado para resolver org/campanha — isso é sempre a LeadSourceBinding, D-041-3).
  google_ads_leads
  /// SPEC-041: App Secret (assinatura X-Hub-Signature-256) e/ou Page Access Token (name=`page:<pageId>`) do Meta Lead Ads.
  meta_leads
}

/// SPEC-041: plataforma de origem de um vínculo Conta de Anúncios/Página -> Campaign (D-041-3).
enum LeadSourceProvider {
  google_ads
  meta
}

enum IntegrationAuditAction {
  create
  rotate
  delete
  test
  update_url
}

model IntegrationSecret {
  id               String          @id @default(uuid())
  orgId            String
  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration      IntegrationKind
  name             String          @default("default")
  encryptedValue   String
  /// Últimos 4 caracteres do valor (exibição).
  hint             String
  baseUrl          String?
  /// "Instância própria": aceita localhost/rede privada (metadados/link-local sempre bloqueados).
  allowPrivateHost Boolean         @default(false)
  updatedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  lastTestError    String?

  @@unique([orgId, integration, name])
}

model IntegrationAuditLog {
  id               String                 @id @default(uuid())
  orgId            String
  org              Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId           String
  integration      IntegrationKind
  action           IntegrationAuditAction
  /// Host mascarado (ex.: "ev***.example.com"); nunca o valor do segredo.
  hostMasked       String?
  /// Confirmação "instância própria" vigente no momento da ação (create/update_url).
  allowPrivateHost Boolean?
  at               DateTime               @default(now())

  @@index([orgId, integration, at])
  @@index([integration, at])
}

/// SPEC-031: acoes cross-tenant do `platform_admin` sobre uma Organization (suspender/reativar).
enum PlatformAuditAction {
  suspend
  reactivate
  /// SPEC-040: platform_admin cria manualmente uma Organization de cortesia (plano "courtesy", sem checkout real).
  create_courtesy_org
}

/// SPEC-031: auditoria "quem/quando/acao/motivo" das acoes cross-tenant do `platform_admin` (mesmo
/// padrao de `IntegrationAuditLog`, SPEC-018). `adminUserId` e so o id (sem relation) de proposito —
/// mesma escolha de `IntegrationAuditLog.userId` — para nao criar dependencia de FK sobre `User` numa
/// tabela de auditoria que deve sobreviver mesmo que a conta do admin seja removida futuramente.
model PlatformAuditLog {
  id          String              @id @default(uuid())
  adminUserId String
  orgId       String
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action      PlatformAuditAction
  reason      String?
  at          DateTime            @default(now())

  @@index([orgId, at])
  @@index([adminUserId, at])
}

// ---------- SPEC-019: Agentes de IA ----------
enum AgentRole {
  sdr
  followup
  closer
}

enum AgentAutonomy {
  draft
  sampled
  auto
}

enum AgentRunStatus {
  queued
  running
  completed
  skipped
  blocked
  handoff
  failed
}

enum DraftStatus {
  pending
  approved
  edited
  rejected
  sent
  expired
  blocked
}

/// SPEC-019/030: kill switch (default LIGADO = agentes desligados) e teto mensal. Ate SPEC-030: singleton global (id="global"). Apos SPEC-030: 1 linha por Organization.
model AgentSettings {
  id                 String       @id @default(uuid())
  orgId              String       @unique
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  killSwitch         Boolean      @default(true)
  monthlyBudgetCents Int?
  updatedAt          DateTime     @updatedAt
  updatedBy          String?
}

model Agent {
  id                 String              @id @default(uuid())
  orgId              String
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  role               AgentRole
  name               String
  active             Boolean             @default(false)
  persona            String              @default("")
  objective          String              @default("")
  tone               String              @default("")
  promptVersion      Int                 @default(1)
  model              String              @default("claude-haiku-4-5")
  autonomy           AgentAutonomy       @default(draft)
  samplePercent      Int                 @default(20)
  /// null = sem teto = agente NÃO executa (padrão desligado até haver teto).
  monthlyBudgetCents Int?
  dailyMessageLimit  Int                 @default(20)
  maxTurnsPerLead    Int                 @default(5)
  allowedTools       String[]
  escalationRules    Json?
  minConfidence      Float               @default(0.6)
  disclosureEnabled  Boolean             @default(false)
  disclosureText     String?
  /// Closer: link https da call, incluído na resposta e no aviso de handoff ao humano.
  callLink           String?
  /// Confirmação explícita (Closer em auto): data da confirmação + aviso de risco de banimento/LGPD.
  autoConfirmedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  updatedBy          String?
  knowledge          KnowledgeDocument[]
  runs               AgentRun[]
  steps              SequenceStep[]

  @@index([orgId])
}

/// SPEC-030: `orgId` direto (alem de `agentId`) para query eficiente e para o caso `agentId` null.
model KnowledgeDocument {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  agentId   String?
  agent     Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String
  content   String
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
  @@index([agentId])
}

model AgentRun {
  id                 String         @id @default(uuid())
  agentId            String
  agent              Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadId             String
  lead               Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepId             String?
  step               SequenceStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)
  touchId            String?
  trigger            String
  status             AgentRunStatus @default(queued)
  model              String?
  tokensIn           Int            @default(0)
  tokensOut          Int            @default(0)
  /// Custo em micro-dólares (1 USD = 1_000_000); orçamento em centavos = 10_000 micro por centavo.
  costMicros         Int            @default(0)
  latencyMs          Int?
  /// Saída estruturada validada (retenção limitada: limpo por purgeAgentData).
  result             Json?
  guardrailsViolated String[]
  error              String?
  createdAt          DateTime       @default(now())
  processedAt        DateTime?
  draft              Draft?

  @@unique([leadId, stepId, trigger])
  @@index([status, createdAt])
  @@index([agentId, createdAt])
}

model Draft {
  id           String      @id @default(uuid())
  agentRunId   String      @unique
  agentRun     AgentRun    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      Channel
  subject      String?
  body         String
  status       DraftStatus @default(pending)
  editedBody   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectReason String?
  touchId      String?
  createdAt    DateTime    @default(now())

  @@index([status, createdAt])
  @@index([leadId])
}

/// SPEC-015: log de execução da busca de leads por IA/fonte oficial. Sem PII: só contadores.
model SearchRun {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source     String
  trigger    String    @default("manual")
  status     String    @default("running")
  requests   Int       @default(0)
  found      Int       @default(0)
  created    Int       @default(0)
  duplicate  Int       @default(0)
  suppressed Int       @default(0)
  invalid    Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([campaignId, startedAt])
}

/// SPEC-021: dispositivo do app mobile. Refresh token NUNCA gravado em claro (só sha256). prevRefreshHash detecta reuso.
model MobileDevice {
  id               String    @id @default(uuid())
  userId           String
  name             String
  platform         String
  refreshHash      String    @unique
  prevRefreshHash  String?
  refreshExpiresAt DateTime
  pushToken        String?
  /// SPEC-023: preferencias de push por kind ({kind: boolean}); ausente = padrao (tudo ligado, exceto lead_replied).
  pushPrefs        Json?
  appVersion       String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?

  @@index([userId, createdAt])
  @@index([prevRefreshHash])
}

/// SPEC-023: alerta de monitoramento deduplicado (dedupeKey unico por episodio). Sem PII em title/body.
/// SPEC-030: `orgId` obrigatorio (vazamento cross-tenant corrigido — a varredura de `src/lib/mobile/alerts.ts`
/// agora roda por Organization ATIVA e cada candidato resolve a org dona do evento antes de criar o alerta).
model MobileAlert {
  id         String       @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind       String
  severity   String
  dedupeKey  String       @unique
  title      String
  body       String
  refType    String
  refId      String?
  /// Link https da call (handoff do Closer); so trafega na API autenticada, nunca no push.
  link       String?
  createdAt  DateTime     @default(now())
  readAt     DateTime?
  resolvedAt DateTime?

  @@index([orgId, createdAt, id])
  @@index([orgId, kind, resolvedAt])
  @@index([createdAt, id])
  @@index([kind, resolvedAt])
}

// ---------- SPEC-033: Billing/assinatura ----------

/// SPEC-033: catalogo de planos (gerido pelo platform_admin; sem endpoint de gestao nesta SPEC, cadastrado via seed).
/// D-33-2: precos/limites sao PLACEHOLDER ate confirmacao explicita do usuario antes do launch.
model Plan {
  id                   String         @id @default(uuid())
  /// Slug estavel usado no codigo (ex. "starter"/"pro"/"business"). Nunca muda depois de criado.
  key                  String         @unique
  name                 String
  priceMonthlyCents    Int
  priceYearlyCents     Int?
  /// PLACEHOLDER (D-33-2): ex. {"maxCampaigns":3,"maxWhatsappInstances":1,"maxLeadsPerMonth":500}. Enforcement fino fica fora do escopo da SPEC-033.
  limits               Json
  /// Permite descontinuar o plano sem apagar historico (assinaturas existentes continuam validas).
  active               Boolean        @default(true)
  /// null com PAYMENT_PROVIDER=mock (sem conta Stripe ainda, D-33-5); preenchido quando o adapter Stripe for ativado.
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  /// D-33-2: Business e "sob consulta", sem checkout self-service (createCheckoutSession recusa este key).
  selfServiceCheckout  Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  subscriptions        Subscription[]
}

/// SPEC-033: 1 assinatura ativa por Organization (orgId unico). `status` e espelho do provedor (Stripe,
/// D-33-1); `Organization.status` e DERIVADO daqui por um unico mapeamento (`src/lib/billing/status-map.ts`)
/// para nao divergir do enforcement do cron (SPEC-030).
model Subscription {
  id                     String             @id @default(uuid())
  orgId                  String             @unique
  org                    Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                 SubscriptionStatus @default(trialing)
  cadence                BillingCadence     @default(monthly)
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  /// D-33-3: trial de 14 dias sem cartao. null fora do periodo de trial.
  trialEndsAt            DateTime?
  /// D-33-3: inicio do `past_due` atual (ancora do grace period de 7 dias). null = em dia.
  pastDueSince           DateTime?
  /// D-33-4: soft-block imediato ao cancelar; ancora dos 90 dias de retencao antes do expurgo.
  canceledAt             DateTime?
  /// Id do customer no provedor externo (Stripe). null em modo mock ate o 1º checkout.
  externalCustomerId     String?
  /// Id da subscription no provedor externo (Stripe). null em modo mock.
  externalSubscriptionId String?
  /// SPEC-047 (D-047-1): true quando o ciclo desta assinatura e cobrado via PIX avulso do AbacatePay
  /// (`transparents/create`) com renovacao controlada pelo LeadForge (src/lib/billing/pix-renewal.ts),
  /// e nao pelo provedor. false/default para os demais casos (mock, Stripe, ou AbacatePay via cartao
  /// tokenizado com `subscriptions/create` — recorrencia REAL gerenciada pelo provedor).
  pixManaged              Boolean            @default(false)
  /// SPEC-047: id da cobranca PIX avulsa pendente do ciclo atual (AbacatePay `transparents/create`).
  /// null quando nao ha cobranca pendente (fora da janela de renovacao, ou o ciclo ja foi pago/tratado).
  pixChargeId             String?
  /// SPEC-047: expiracao da cobranca PIX pendente (`data.expiresAt` do AbacatePay). O job de renovacao usa
  /// isto para decidir "venceu sem pagamento" (equivalente a cartao recusado, D-047-1) sem criar um
  /// mecanismo de bloqueio paralelo — a transicao em si e sempre feita via processBillingEvent/status-map.ts.
  pixChargeExpiresAt     DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([pixManaged, status])
}

/// SPEC-039 (D-039-2): "aviso ja enviado" por episodio de cobranca — idempotencia dos e-mails de
/// lembrete/aviso disparados em cima do fluxo de billing ja existente (SPEC-033), sem tocar na
/// logica/timing de bloqueio (D-039-3). `anchorAt` e o timestamp que ANCORA o episodio sendo avisado
/// (`trialEndsAt` para trial_ending, `pastDueSince` para past_due_started/auto_suspended — mesmo
/// episodio de past_due gera os dois avisos com a MESMA ancora —, `canceledAt` para purge_warning):
/// se a org passar por um NOVO episodio (ex.: novo `past_due` apos voltar a ficar em dia), a ancora
/// muda e o aviso e enviado de novo; reprocessar o MESMO episodio (cron rodando de novo) nao duplica
/// porque `@@unique([orgId, kind, anchorAt])` bloqueia o INSERT repetido antes do e-mail ser enviado.
model BillingReminderLog {
  id        String              @id @default(uuid())
  orgId     String
  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind      BillingReminderKind
  anchorAt  DateTime
  sentAt    DateTime            @default(now())

  @@unique([orgId, kind, anchorAt])
  @@index([orgId, kind])
}

enum BillingReminderKind {
  trial_ending
  past_due_started
  auto_suspended
  purge_warning
}

/// SPEC-026: auditoria das acoes de gestao do app (sem PII: so ids) + idempotencia por (deviceId, Idempotency-Key).
model MobileActionLog {
  id             String   @id @default(uuid())
  userId         String
  deviceId       String
  action         String
  target         String?
  outcome        String
  idempotencyKey String?
  respStatus     Int?
  respBody       Json?
  createdAt      DateTime @default(now())

  @@unique([deviceId, idempotencyKey])
  @@index([userId, createdAt])
}
